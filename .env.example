# Copiá este archivo como .env y completá los valores. El archivo .env NO se sube a git.

# Puerto del servidor (Render lo define solo)
PORT=3000

# Clave para firmar las sesiones. Generá una larga y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Administrador inicial (se crea al arrancar si no existe). Usá tu propio email y una contraseña de 8+ caracteres.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Dónde se guarda la base SQLite (en Render: ruta dentro del disco persistente, ej. /var/data/cine.db)
DB_PATH=backend/data/cine.db

# Solo si el frontend está publicado aparte (ej. Netlify): origen permitido por CORS, sin barra final.
# Si se deja vacío, solo se aceptan pedidos del mismo origen.
FRONTEND_URL=
